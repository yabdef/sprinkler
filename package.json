{
  "name": "sprinkler-system",
  "version": "0.1.0",
  "description": "Sprinkler tesisatı çizim ve hidrolik hesap uygulaması",
  "private": true,
  "main": "electron/main.cjs",
  "dependencies": {
    "bootstrap-icons": "^1.11.3",
    "exceljs": "^4.4.0",
    "konva": "^9.3.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "7.18.4",
    "sass": "1.105.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "build": {
    "extends": null,
    "appId": "tr.sprinkler.tesisati",
    "productName": "Sprinkler Tesisatı",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Sprinkler-Tesisati-${version}-${arch}-Kurulum.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sprinkler Tesisatı"
    },
    "portable": {
      "artifactName": "Sprinkler-Tesisati-${version}-${arch}-Tasinabilir.${ext}"
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "@electron/get": "5.1.0",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
