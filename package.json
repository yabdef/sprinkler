{
  "name": "sprinkler-system",
  "version": "0.1.0",
  "description": "Sprinkler tesisatı çizim ve hidrolik hesap uygulaması",
  "private": true,
  "main": "electron/main.cjs",
  "homepage": "./",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.6",
    "bootstrap-icons": "^1.11.3",
    "exceljs": "^4.4.0",
    "konva": "^9.3.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.26.1",
    "react-scripts": "5.0.1",
    "sass": "^1.77.8",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "extends": null,
    "appId": "tr.sprinkler.tesisati",
    "productName": "Sprinkler Tesisatı",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Sprinkler-Tesisati-${version}-${arch}-Kurulum.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sprinkler Tesisatı"
    },
    "portable": {
      "artifactName": "Sprinkler-Tesisati-${version}-${arch}-Tasinabilir.${ext}"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
